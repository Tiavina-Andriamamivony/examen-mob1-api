{
  "name": "posu-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch './*' --exec ts-node src/index.ts",
    "build": "npx prisma generate && tsc && cp -r docs dist/docs",
    "start": "node -r module-alias/register dist/src/index.js",
    "format": "prettier --write \"./**/*.{ts,json}\" --config \".prettierrc.json\"",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "gen:client": "./generate-client.sh",
    "studio": "prisma studio",
    "swagger:build": "npx js-yaml docs/api.yml > docs/openapi.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "dotenv -e .env.test -- npx prisma migrate deploy && dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npx dotenv -e .env.test -- npx prisma migrate deploy && npx dotenv -e .env.test -- npm run test:integration && rm -f test.db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.16.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-node": "10.9.1",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "esm-module-alias": "^2.2.1",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.0",
    "pdfkit": "^0.17.2",
    "prisma": "^6.5.0",
    "swagger-ui-express": "^5.0.1",
    "tslog": "^4.10.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "_moduleAliases": {
    "@": "./dist/src",
    "@docs": "./dist/docs",
    "@clients": "./dist/clients"
  }
}
